#!/bin/sh
set -euo pipefail

usage() {
    >&2 printf '%s\n' \
        'usage: ./do deploy <host ...> [-- <nixos-rebuild args ...>]' \
        '       ./do read <host ...>' \
        '       ./do write <host ...>' \
        '       ./do restart-monitor <host ...>' \
        '       ./do restart-queue <host ...>' \
        '       ./do run <host ...> -- <command ...>' \
        '       ./do logs <host>' \
        '       ./do mosh <host> [command ...]' \
        '       ./do htop <host>'
    exit 1
}

# Print usage if there is no argument supplied.
[ $# -gt 0 ] || usage
action=$1; shift

case "$action" in
(deploy)
    hosts=
    for arg; do
        case "$arg" in
        (--)
            shift
            break
            ;;
        (*)
            hosts="$hosts $arg"
            shift
            ;;
        esac
    done
    # If no action is provided, default to using "switch".
    if [ $# -eq 0 ]; then
        set -- switch
    fi
    for host in $hosts; do
        nixos-rebuild "$@" --fast \
            --flake .#"$host" \
            --target-host root@"$host".servo.org \
            -v --log-format internal-json 2>&1 | nom --json
    done
    for host in $hosts; do
        printf '>>> %s\n' https://"$host".servo.org
    done
    ;;
(read)
    for host; do
        mkdir -p -- "$host"
        rsync root@"$host".servo.org:/config/monitor/.env \
              root@"$host".servo.org:/config/monitor/monitor.toml \
        "$host"/
    done
    ;;
(write)
    for host; do
        rsync "$host"/.env "$host"/monitor.toml  root@"$host".servo.org:/config/monitor/
    done
    ;;
(restart-monitor)
    for host; do
        ssh root@"$host".servo.org systemctl restart monitor
    done
    for host; do
        printf '>>> %s\n' https://"$host".servo.org
    done
    ;;
(restart-queue)
    for host; do
        ssh root@"$host".servo.org systemctl restart queue
    done
    for host; do
        printf '>>> %s\n' https://"$host".servo.org/queue/
    done
    ;;
(run)
    hosts=
    for arg; do
        case "$arg" in
        (--)
            shift
            break
            ;;
        (*)
            hosts="$hosts $arg"
            shift
            ;;
        esac
    done
    for host in $hosts; do
        ssh root@"$host".servo.org -- "$@"
    done
    ;;
(mosh)
    host=$1; shift
    mosh root@"$host".servo.org -- "$@"
    ;;
(logs)
    mosh root@"$1".servo.org tmux new 'journalctl -af'
    ;;
(htop)
    mosh root@"$1".servo.org tmux new 'htop'
    ;;
(*)
    usage
    ;;
esac
